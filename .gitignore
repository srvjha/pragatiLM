# client/ and server/ each carry their own .gitignore, because either project can
# be cloned and worked on without this file being present. This one covers only
# what sits at the top level, plus a safety net for the things that must never
# be committed no matter where in the tree they appear.

node_modules/
dist/
.next/
test-results/
playwright-report/

.DS_Store
*.log

# Never commit a real env file from anywhere in the tree.
.env
.env.*
!.env.example
