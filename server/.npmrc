# @langchain/community still declares a peer range for zod 3, while this project
# and better-auth are both on zod 4. The installed tree works — langchain reads
# zod through @langchain/core, which is on 4 as well — but npm's strict peer
# resolution refuses it, so `npm ci` fails on a clean checkout while a laptop
# with an older node_modules carries on working.
#
# Set here rather than passed as a flag so a clean install behaves the same for
# everyone: a laptop, an image build, and whatever runs this next.
legacy-peer-deps=true
