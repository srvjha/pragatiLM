# Production values for the VPS. Copy to .env beside docker-compose.prod.yml.
#
# Everything the app needs is here; the compose file passes this whole file to
# the api, worker and migrate services. It is never committed — .env is ignored
# in every directory of this repo.

NODE_ENV=production
API_PORT=4000

# The front end on Vercel. Same registrable domain as the API below, which is
# what keeps the session cookie an ordinary SameSite=Lax one.
WEB_ORIGIN=https://pragati.srvjha.in
# This API's public address. OAuth callbacks are built from it, so it must be
# the name the browser uses rather than localhost.
BETTER_AUTH_URL=https://backend-pragati.srvjha.in
# Both halves are under srvjha.in, so the cookie is not cross-site.
AUTH_COOKIE_CROSS_SITE=false

#   openssl rand -base64 32
# The app refuses to start in production without it, by design.
BETTER_AUTH_SECRET=

# Service names, not localhost: these resolve on the compose network.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=notebook_rag
DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/notebook_rag
REDIS_URL=redis://redis:6379
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=chunks

# The SQL retrieval route runs generated statements as a read-only role.
# Migration 0001 creates the role and its grants, so there is nothing to do by
# hand — but leave this blank and that route stays switched off, with a warning
# in the log rather than an error.
DATABASE_URL_READONLY=postgresql://notebook_ro:notebook_ro@postgres:5432/notebook_rag

OPENAI_API_KEY=
COHERE_API_KEY=
RERANK_ENABLED=true

# Text to speech. sarvam for Hindi and Indian English.
TTS_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_MODEL=bulbul:v3
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICES=

# yt-dlp is installed in the image, so this stays empty and the binary on PATH
# is used. Nothing needs installing on the host.
YTDLP_PATH=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
