# Copy to .env and fill in. Parsed once through zod at boot by src/config/env.ts,
# which fails startup with a readable message rather than surfacing later.

# Core
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
WORKER_QUEUES=chat,ingest,cleanup,roadmap,podcast
CHAT_QUEUE_CONCURRENCY=8

# Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/notebook_rag
# Least privilege role used only to execute generated SQL for the SQL retrieval
# route. SELECT on the allowlisted tables and nothing else, so read only is
# enforced by the database rather than by inspecting the statement.
DATABASE_URL_READONLY=postgresql://notebook_ro:notebook_ro@localhost:5432/notebook_rag

# Redis
REDIS_URL=redis://localhost:6379

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=chunks

# Models
# openai needs OPENAI_API_KEY. Set this to "fake" to run the whole product with
# no API key: ingestion, status and the UI all work, but retrieval returns
# meaningless results because the vectors carry no semantics.
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
CHAT_MODEL=gpt-4.1-mini
QUERY_MODEL=gpt-4.1-nano
GRADER_MODEL=gpt-4.1-nano
COHERE_API_KEY=
RERANK_ENABLED=true

# Text to speech
TTS_PROVIDER=openai
TTS_VOICE_FEMALE=nova
TTS_VOICE_MALE=onyx
ELEVENLABS_API_KEY=

# Chunking
CHUNK_TARGET_TOKENS=900
CHUNK_OVERLAP_TOKENS=150

# Query translation
QUERY_TRANSLATION_ENABLED=true
REWRITE_ENABLED=true
STEPBACK_ENABLED=true
SUBQUESTIONS_ENABLED=true
SUBQUESTION_MAX=3
HYDE_ENABLED=true

# Routing and retrieval
QUERY_ROUTING_ENABLED=true
SQL_ROUTE_ENABLED=true
SQL_MAX_ROWS=50
SQL_TIMEOUT_MS=2000
RRF_K=60
RETRIEVAL_TOP_K=30
RERANK_TOP_N=8
RELEVANCE_FLOOR=0.25

# Corrective RAG
CRAG_ENABLED=true
CRAG_MIN_SCORE=6
CRAG_MAX_RETRIES=3
CRAG_WALL_CLOCK_MS=15000

# Uploads
MAX_UPLOAD_MB=50
