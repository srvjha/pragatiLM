# Copy to .env and fill in. Parsed once through zod at boot by src/config/env.ts,
# which fails startup with a readable message rather than surfacing later.

# Core
NODE_ENV=development
API_PORT=4000
# Comma separate to allow more than one, e.g. a preview deployment alongside
# production. Every entry must be a full origin including the scheme.
WEB_ORIGIN=http://localhost:3000,http://localhost:3001
WORKER_QUEUES=chat,ingest,cleanup,roadmap,podcast
CHAT_QUEUE_CONCURRENCY=8

# Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/notebook_rag
# Least privilege role used only to execute generated SQL for the SQL retrieval
# route. SELECT on the allowlisted tables and nothing else, so read only is
# enforced by the database rather than by inspecting the statement.
DATABASE_URL_READONLY=postgresql://notebook_ro:notebook_ro@localhost:5432/notebook_rag

# Authentication
# Signs session cookies. Required in production, which refuses to start without
# it. Development falls back to a fixed insecure value so the product runs
# before anyone has generated anything.
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# Where the auth routes are reachable, which is this API rather than the web
# app. OAuth callbacks are built from it, so behind a proxy this must be the
# public URL.
BETTER_AUTH_URL=http://localhost:4000

# Social sign in is optional. Email and password always works and needs no
# credential here. A provider is registered only when both halves are filled,
# so leaving a pair blank simply means no button for it on the sign in page.
#
# Google:  https://console.cloud.google.com/apis/credentials
#          Redirect URI: http://localhost:4000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub:  https://github.com/settings/developers
#          Callback URL: http://localhost:4000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Set to true ONLY when the web app and this API are on different registrable
# domains, for example a web app on one host's subdomain talking to an API on
# another's. It switches the session cookie to SameSite=None, which browsers
# accept over HTTPS only, so it forces Secure on with it. With both under one
# domain (yourdomain.com and api.yourdomain.com) leave this false.
#
# Getting this wrong fails badly: sign in appears to succeed and then every
# request arrives without a session, because SameSite is decided by the
# registrable domain rather than the origin.
AUTH_COOKIE_CROSS_SITE=false

# Redis
REDIS_URL=redis://localhost:6379

# YouTube captions
# YouTube stopped serving caption tracks to anyone but itself: the timedtext
# endpoint returns an empty body and the transcript API answers 400, for every
# video, including ones with dozens of hand written tracks. yt-dlp is the only
# route through, because keeping up with those changes is its whole purpose.
#
#   brew install yt-dlp        (or: pipx install yt-dlp)
#
# Leave the path blank to use whatever is on PATH. Without yt-dlp installed,
# YouTube sources fail with an explanation and VTT or SRT upload still works;
# nothing else in the product is affected.
YTDLP_PATH=

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=chunks

# Models
# openai needs OPENAI_API_KEY. Set this to "fake" to run the whole product with
# no API key: ingestion, status and the UI all work, but retrieval returns
# meaningless results because the vectors carry no semantics.
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
CHAT_MODEL=gpt-4.1-mini
QUERY_MODEL=gpt-4.1-nano
GRADER_MODEL=gpt-4.1-mini
# Translates a transcript for the viewer's language switch. Nano because this
# is mechanical, heavily parallel, and somebody is waiting on it. Raise it to
# gpt-4.1-mini if translations read badly: nano is weaker on Devanagari, which
# is the script most likely to need translating in the first place.
TRANSLATE_MODEL=gpt-4.1-nano
COHERE_API_KEY=
RERANK_ENABLED=true

# Text to speech.
#
# TTS_PROVIDER picks the shape of the service. `openai` covers everything that
# speaks the OpenAI audio API — OpenAI itself, or Kokoro either hosted or in a
# container. `sarvam` is a different API, and the one to pick for Hindi or
# Indian English: the OpenAI voices are English models reading Devanagari,
# which is what makes them sound robotic.
#
#   Sarvam Bulbul — Hindi and Indian English
#     Keys: https://dashboard.sarvam.ai — signup credit is granted automatically,
#     no card, and the Starter tier begins at ₹100. Billed per character: the
#     listed rate is ₹30 per 10k, though measured spend on a Starter account
#     came to about half that. A three minute episode costs roughly ₹3.50, so
#     the signup credit is worth about twenty five of them. Balance lives at
#     https://dashboard.sarvam.ai/billing.
#     TTS_PROVIDER=sarvam
#     SARVAM_API_KEY=<your key>
#
#   Kokoro, hosted — Apache licensed, ~20x cheaper than gpt-4o-mini-tts
#     TTS_BASE_URL=https://api.deepinfra.com/v1/openai
#     TTS_API_KEY=<your DeepInfra key>
#     TTS_MODEL=hexgrad/Kokoro-82M
#     TTS_VOICES=kokoro
#
#   Kokoro, in a container (docker run -p 8880:8880 ghcr.io/remsky/kokoro-fastapi-cpu)
#     TTS_BASE_URL=http://localhost:8880/v1
#     TTS_API_KEY=not-needed
#     TTS_MODEL=kokoro
#     TTS_VOICES=kokoro
#
TTS_PROVIDER=openai

# Sarvam
SARVAM_API_KEY=
SARVAM_MODEL=bulbul:v3

# OpenAI-shaped. Empty base url means OpenAI itself, through OPENAI_API_KEY.
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
# Leave unset to follow TTS_PROVIDER. Set it only when pointing the
# OpenAI-shaped client somewhere with different voice names, i.e. Kokoro.
TTS_VOICES=

# Optional. Overrides the two voices the "Warm" pair uses; the other pairs come
# from the voice set. Leave unset unless you want specific voices, because a
# name from the wrong backend is rejected at synthesis time.
TTS_VOICE_FEMALE=
TTS_VOICE_MALE=

# Chunking
CHUNK_TARGET_TOKENS=900
CHUNK_OVERLAP_TOKENS=150

# Query translation
QUERY_TRANSLATION_ENABLED=true
REWRITE_ENABLED=true
STEPBACK_ENABLED=true
SUBQUESTIONS_ENABLED=true
SUBQUESTION_MAX=3
HYDE_ENABLED=true

# Routing and retrieval
QUERY_ROUTING_ENABLED=true
SQL_ROUTE_ENABLED=true
SQL_MAX_ROWS=50
SQL_TIMEOUT_MS=2000
RRF_K=60
RETRIEVAL_TOP_K=30
RERANK_TOP_N=8
RELEVANCE_FLOOR=0.25

# Corrective RAG
CRAG_ENABLED=true
# Below this the search widens and runs again.
CRAG_MIN_SCORE=6
# Below this the system refuses to answer at all. Deliberately far lower than
# CRAG_MIN_SCORE: a partially sufficient set should still produce an answer
# citing what it does support, rather than nothing.
CRAG_REFUSE_BELOW=3
CRAG_MAX_RETRIES=3
CRAG_WALL_CLOCK_MS=15000

# Uploads
MAX_UPLOAD_MB=50
