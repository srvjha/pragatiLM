{
  "name": "notebook-rag-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Notebook RAG backend: API and queue workers",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@bull-board/api": "^6.14.1",
    "@bull-board/express": "^6.14.1",
    "@langchain/cohere": "^1.1.0",
    "@langchain/core": "^1.2.3",
    "@langchain/openai": "^1.5.5",
    "@langchain/qdrant": "^1.0.3",
    "@langchain/textsplitters": "^1.0.1",
    "@mozilla/readability": "^0.6.0",
    "@qdrant/js-client-rest": "^1.15.1",
    "bullmq": "^5.81.2",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "hash-wasm": "^4.12.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "ipaddr.js": "^2.2.0",
    "js-tiktoken": "^1.0.21",
    "jsdom": "^29.1.1",
    "langchain": "^1.5.4",
    "multer": "^2.0.2",
    "openai": "^6.9.0",
    "p-limit": "^7.3.1",
    "p-retry": "^8.0.0",
    "p-timeout": "^7.0.1",
    "pg": "^8.16.3",
    "pino": "^9.13.1",
    "pino-http": "^11.0.0",
    "sanitize-filename": "^1.6.3",
    "subtitle": "^4.2.2",
    "undici": "^8.9.0",
    "unpdf": "^1.8.0",
    "youtubei.js": "^17.2.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "lint-staged": "^16.2.6",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,js,json,md}": "prettier --write",
    "*.ts": "eslint --fix"
  }
}
